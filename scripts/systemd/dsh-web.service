# /etc/systemd/system/dsh-web.service
# 注意：--public-url 与 --trusted-host 必须和实际对外地址一致，否则 token 链接和 Host 校验会对不上。
[Unit]
Description=DeepSeek Harness Web (dsh)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
Environment=HOME=/home/ubuntu
Environment=PATH=/usr/local/lib/nodejs/node-v24.22.3-linux-arm64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/bin/dsh web --no-open --port 3080 \
  --public-url http://16.179.221.157:3081 \
  --trusted-host 16.179.221.157 \
  --trusted-host 16.179.221.157:3081
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
