# /etc/systemd/system/dsh-port3081.service
# 独立入口：dsh 自己只监听 127.0.0.1:3080，这里再做一次对外转发。
# 与 dsh-web.service 解耦，重启 dsh 不会把它一起带走。
[Unit]
Description=dsh web extra ingress on :3081 -> 127.0.0.1:3080
After=network-online.target dsh-web.service
Wants=network-online.target

[Service]
User=ubuntu
ExecStart=/usr/bin/socat TCP-LISTEN:3081,fork,reuseaddr TCP:127.0.0.1:3080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
